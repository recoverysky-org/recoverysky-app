# EAS Build ignore file
# Based on .gitignore but includes files needed for native builds
# (e.g. Zoom SDK zip for AAR extraction during postinstall)

# OSX
.DS_Store
.env
.envrc
credentials.json

# Native folders (generated by prebuild - CNG)
android/
ios/

# Zoom repos (but NOT the SDK zip — needed for AAR extraction)
MeetingSDK-ReactNative-Quickstart/
meetingsdk-web-sample/

# Xcode
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.aab
*.apk
*.xcuserstate
ios/.xcode.env.local

# build outputs
build*.tar.gz
recoveryskyhybrid.app/

# Android/IntelliJ
*.apk
build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/

# node.js
node_modules/
npm-debug.log
yarn-error.log

# BUCK
buck-out/
\.buckd/
*.keystore
*.jks
*.pem
!debug.keystore
!upload-keystore.jks
*-service-key.json

# fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# VS Code
.vscode

# Expo
.expo/*
bin/Exponent.app
expo-env.d.ts

## Secrets
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Configurations
!env.js

/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Dependency Graph Visualizations
app-dependency-graph.svg
app-dependency-graph.png

.expo/

# SQLite database files
*.db

# ---------------------------------------------------------------------------
# Build-archive size reductions (added to keep the EAS upload small).
# Anything below this line is NOT required for `eas build` or `eas update` to
# succeed — purely development/test/docs/CI artifacts.
# ---------------------------------------------------------------------------

# Web export output from `npm run bundle:web` (~77 MB). Cloud builds don't
# need this — they regenerate it on demand.
dist/

# Ignite generator templates (used by the CLI during code generation only).
ignite/

# Standalone test directory + colocated test files in app/. The cloud build
# never runs these.
test/
**/*.test.ts
**/*.test.tsx
**/*.e2e.test.ts
**/*.integration.test.ts
**/__tests__/
**/__snapshots__/

# E2E flow specs (Maestro) — only executed by `npm run test:maestro` locally.
.maestro/

# Forgejo CI workflows — checked out on demand by `npm run actions`.
.forgejo/

# Internal docs that aren't shipped with the bundle. README.md and
# LICENSE.md are intentionally NOT excluded (LICENSE.md is referenced by
# OnboardingOSS).
docs/
CHANGELOG.md
CLAUDE.md
CONTRIBUTING.md
EVENTS.md

# Local credential staging directory (separate from credentials.json which
# is already excluded above).
credentials/

# Editor / OS noise that isn't already covered above.
.idea/
*.swp
*.swo
