{
  "name": "recoverysky-app",
  "version": "4.1.3",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "actions": "rm -rf ./.forgejo/actions && git clone --depth 1 https://git.rso/recoverysky-org/forgejo-actions.git ./.forgejo/actions && rm -rf ./.forgejo/actions/.git",
    "postinstall": "patch-package && bash scripts/patch-zoom-android.sh",
    "patch:zoom:android": "bash scripts/patch-zoom-android.sh",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild:ios:clean": "npx expo prebuild --platform ios --clean && npm run patch:ios",
    "prebuild:android:clean": "npx expo prebuild --platform android --clean && npm run patch:android && npm run patch:zoom:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "bundle:web": "npx expo export --platform web",
    "serve:web": "npx serve dist",
    "prebuild:clean": "npx expo prebuild --clean && npm run patch:android && npm run patch:ios && npm run patch:zoom:android",
    "patch:android": "bash scripts/patch-android.sh",
    "patch:ios": "bash scripts/patch-ios.sh",
    "generate:icons": "bash scripts/generate-icons.sh",
    "compile": "tsc --noEmit -p . --pretty",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:deps": "depcruise app --config .dependency-cruiser.js",
    "lint:deps:graph": "depcruise app --include-only \"^app\" --config .dependency-cruiser.js --output-type dot > app-dependency-graph.dot && dot -T svg app-dependency-graph.dot -o app-dependency-graph.svg && dot -T png app-dependency-graph.dot -o app-dependency-graph.png && rm app-dependency-graph.dot",
    "align-deps": "npx expo install --fix",
    "test": "vitest run && jest --forceExit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:component": "jest --forceExit",
    "test:component:watch": "jest --watch",
    "test:all": "vitest run && jest --forceExit",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=live.meetingmaker.app.prod .maestro/flows",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "build:ios:sim": "EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development --platform ios --local",
    "build:ios:device": "EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development:device --platform ios --local",
    "build:ios:preview": "EXPO_NO_CAPABILITY_SYNC=1 eas build --profile preview --platform ios --local",
    "build:ios:preview:device": "EXPO_NO_CAPABILITY_SYNC=1 eas build --profile preview:device --platform ios --local",
    "build:ios:prod": "EXPO_NO_CAPABILITY_SYNC=1 eas build --profile production --platform ios --local",
    "build:android:sim:debug": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=x86_64 && cd ..",
    "build:android:sim:release": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=x86_64 && cd ..",
    "build:android:device:debug": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a && cd ..",
    "build:android:device:debug:arm32": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=armeabi-v7a && cd ..",
    "build:android:device:release": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a && cd ..",
    "build:android:device:release:arm32": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=armeabi-v7a && cd ..",
    "build:android:prod": "eas build --profile production --platform android --local",
    "submit:ios": "eas submit --platform ios --path $(ls -t build-*.ipa 2>/dev/null | head -1)",
    "submit:android": "eas submit --platform android --path $(ls -t build-*.apk build-*.aab 2>/dev/null | head -1)",
    "release:ios": "eas build --platform ios --profile production && eas submit --platform ios --latest",
    "release:android": "eas build --platform android --profile production && eas submit --platform android --latest",
    "install:ios:sim": "tar -xzf $(ls -t build*.tar.gz | head -1) -C /tmp && xcrun simctl install booted /tmp/recoveryskyapp.app",
    "launch:ios:sim": "xcrun simctl launch booted live.meetingmaker.app.prod",
    "deploy:ios:sim": "npm run install:ios:sim && npm run launch:ios:sim",
    "install:android": "adb install -r $(ls -t android/app/build/outputs/apk/debug/app-debug.apk android/app/build/outputs/apk/release/app-release.apk build-*.apk 2>/dev/null | head -1)",
    "launch:android": "adb shell am start -n live.meetingmaker.app.prod/.MainActivity",
    "deploy:android": "npm run install:android && npm run launch:android",
    "patch": "bash scripts/bump-version.sh patch",
    "minor": "bash scripts/bump-version.sh minor",
    "major": "bash scripts/bump-version.sh major"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.5",
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@expo/app-integrity": "^0.1.10",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@recoverysky-org/common": "^1.17.1",
    "@revenuecat/purchases-js": "^1.23.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@trex-ts/core": "^1.5.6",
    "@ungap/structured-clone": "^1.3.0",
    "@zoom/meetingsdk": "^5.0.2",
    "@zoom/meetingsdk-react-native": "^6.7.2",
    "ai": "^6.0.5",
    "apisauce": "3.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "expo": "~54.0.33",
    "expo-application": "~7.0.7",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.10",
    "expo-build-properties": "~1.0.9",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.12",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-sqlite": "^16.0.10",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.10",
    "i18next": "^23.14.0",
    "intl-pluralrules": "^2.0.1",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "mobx-state-tree": "^7.0.2",
    "onesignal-expo-plugin": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.0.1",
    "react-native": "0.81.5",
    "react-native-auth0": "^5.4.0",
    "react-native-drawer-layout": "^4.0.1",
    "react-native-edge-to-edge": "~1.6.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-mmkv": "3.3.3",
    "react-native-onesignal": "^5.3.1",
    "react-native-purchases": "^9.6.12",
    "react-native-purchases-ui": "^9.6.12",
    "react-native-pure-jwt": "^3.1.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.6.1",
    "reanimated-color-picker": "^4.1.1",
    "setimmediate": "^1.0.5",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@vitest/coverage-v8": "^4.0.16",
    "babel-jest": "^29.2.1",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "dependency-cruiser": "^17.0.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-reactotron": "^0.1.2",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.17",
    "jsdom": "^27.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.0",
    "reactotron-core-client": "^2.9.4",
    "reactotron-react-js": "^3.3.11",
    "reactotron-react-native": "^5.0.5",
    "reactotron-react-native-mmkv": "^0.2.6",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@ai-sdk/react": {
      "react": "$react"
    },
    "@zoom/meetingsdk": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets",
        "@react-native-community/datetimepicker",
        "react",
        "react-dom"
      ]
    }
  }
}
