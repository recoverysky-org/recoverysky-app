{
  "cli": {
    "version": ">= 3.15.1",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EXPO_PUBLIC_RESEED_DB": "false",
        "EXPO_PUBLIC_API_URL": "https://api.recoverysky.app",
        "EXPO_PUBLIC_AGENT_URL": "https://agent.recoverysky.app",
        "EXPO_PUBLIC_SOCIAL_URL": "https://social.recoverysky.app",
        "EXPO_PUBLIC_UMAMI_URL": "https://umami.recoverysky.app",
        "EXPO_PUBLIC_UMAMI_WEBSITE_ID": "de38e9ea-85fa-4572-aa6f-83e97e0ff45a",
        "EXPO_PUBLIC_MIN_CREDIT_MINUTES": "1",
        "EXPO_PUBLIC_REVIEW_ENABLED": "false",
        "EXPO_PUBLIC_REVIEW_MIN_MEETINGS": "4",
        "EXPO_PUBLIC_REVIEW_REMINDER_MEETINGS": "3",
        "EXPO_PUBLIC_OTLP_ENDPOINT": "https://otlp.recoverysky.app",
        "EXPO_PUBLIC_SENTRY_DSN": "https://6736a52fda828727e947ef01a032d7a0@o4511300167532544.ingest.us.sentry.io/4511300201021440",
        "SENTRY_AUTH_TOKEN": "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",
        "EXPO_PUBLIC_ZOOM_APP_REDIRECT_URI": "recoverysky-app://oauth/zoom/success",
        "EXPO_PUBLIC_ZOOM_AUTHORIZE_URL": "https://zoom.us/oauth/authorize",
        "EXPO_PUBLIC_ZOOM_SERVER_CALLBACK_URL": "https://zak.recoverysky.app/oauth/callback",
        "EXPO_PUBLIC_ZAK_ME_ENDPOINT": "https://zak.recoverysky.app/zak/me",
        "EXPO_PUBLIC_USE_ZAK": "true",
        "EXPO_PUBLIC_AUTH0_DOMAIN": "auth.recoverysky.app",
        "EXPO_PUBLIC_AUTH0_AUDIENCE": "https://api.recoverysky.app",
        "EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER": "568757477015",
        "EXPO_PUBLIC_CONFIG_POLL_SECONDS": "60",
        "EXPO_PUBLIC_CONFIG_POLL_MAINTENANCE_SECONDS": "15"
      }
    },
    "development": {
      "extends": "base",
      "channel": "development",
      "distribution": "internal",
      "env": {
        "GRADLE_OPTS": "-Xmx8192m -XX:MaxMetaspaceSize=1024m",
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EXPO_PUBLIC_LOG_LEVEL": "debug"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=x86_64"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true
      }
    },
    "development:device": {
      "extends": "development",
      "distribution": "internal",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": false
      }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_LOG_LEVEL": "info"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview:device": {
      "extends": "preview",
      "ios": { "simulator": false }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EXPO_PUBLIC_LOG_LEVEL": "trace"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium",
        "credentialsSource": "local"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}
