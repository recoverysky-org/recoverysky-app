{
  "cli": {
    "version": ">= 3.15.1",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_RESEED_DB": "false",
        "EXPO_PUBLIC_API_URL": "https://api.recoverysky.app",
        "EXPO_PUBLIC_AGENT_URL": "https://agent.recoverysky.app"
      }
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "GRADLE_OPTS": "-Xmx8192m -XX:MaxMetaspaceSize=1024m",
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EXPO_PUBLIC_LOG_LEVEL": "debug"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=x86_64"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true
      }
    },
    "development:device": {
      "extends": "development",
      "distribution": "internal",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": false
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_LOG_LEVEL": "info"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview:device": {
      "extends": "preview",
      "ios": { "simulator": false }
    },
    "production": {
      "extends": "base",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EXPO_PUBLIC_LOG_LEVEL": "warn",
        "EXPO_PUBLIC_ONESIGNAL_MODE": "production"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium",
        "credentialsSource": "local"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
