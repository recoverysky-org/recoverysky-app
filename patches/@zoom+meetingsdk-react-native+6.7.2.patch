+// Track whether JS listeners are registered to avoid sending events
+// before the bridge/TurboModule system is ready (causes crash on New Arch)
+- (void)startObserving {
+    _hasListeners = YES;
+}
+
+- (void)stopObserving {
+    _hasListeners = NO;
+}
+
+// Safe wrapper — only emit if JS side is listening
+- (void)safeEmit:(NSString *)eventName body:(NSDictionary *)body {
+    if (_hasListeners) {
+        [self sendEventWithName:eventName body:body];
+    } else {
+        NSLog(@"[RNZoomSDK] Event dropped (no listeners): %@", eventName);
+    }
+}
