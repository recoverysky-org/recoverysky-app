+        case MobileRTCMeetingEndReason_JBHTimeout:
+            reasonName = @"joinBeforeHostTimeout";
+            break;
+        case MobileRTCMeetingEndReason_FreeMeetingTimeout:
+            reasonName = @"freeMeetingTimeout";
+            break;
+        case MobileRTCMeetingEndReason_NoAteendee:
+            reasonName = @"noAttendee";
+            break;
+        case MobileRTCMeetingEndReason_HostEndForAnotherMeeting:
+            reasonName = @"hostStartedAnotherMeeting";
+            break;
+        case MobileRTCMeetingEndReason_ConnectBroken:
+            reasonName = @"connectionBroken";
+            break;
+        default:
+            reasonName = @"unknown";
+    }
+
+    [self safeEmit:@"onMeetingEndedReason" body:@{
+        @"reason": @(reason),
+        @"reasonName": reasonName
+    }];
+}
+
+- (void)onMeetingParameterNotification:(MobileRTCMeetingParameter *_Nullable)meetingParam {
+    NSLog(@"[RNZoomSDK] onMeetingParameterNotification: host=%@, topic=%@",
+          meetingParam.meetingHost, meetingParam.meetingTopic);
+    _lastMeetingParam = meetingParam;
+}
+
 @end
