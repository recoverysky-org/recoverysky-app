+  @Override
+  public void onMeetingStatusChanged(MeetingStatus meetingStatus, int errorCode, int internalErrorCode) {
+    Log.d(DEBUG_TAG, "[RNZoomSDK] onMeetingStatusChanged: " + meetingStatus + ", errorCode: " + errorCode);
+
+    String stateName;
+    switch (meetingStatus) {
+      case MEETING_STATUS_IDLE:
+        stateName = "idle";
+        break;
+      case MEETING_STATUS_CONNECTING:
+        stateName = "connecting";
+        break;
+      case MEETING_STATUS_WAITINGFORHOST:
+        stateName = "waitingForHost";
+        break;
+      case MEETING_STATUS_INMEETING:
+        stateName = "inMeeting";
+        break;
+      case MEETING_STATUS_DISCONNECTING:
+        stateName = "disconnecting";
+        break;
+      case MEETING_STATUS_RECONNECTING:
+        stateName = "reconnecting";
+        break;
+      case MEETING_STATUS_FAILED:
+        stateName = "failed";
+        break;
+      case MEETING_STATUS_IN_WAITING_ROOM:
+        stateName = "inWaitingRoom";
+        break;
+      case MEETING_STATUS_WEBINAR_PROMOTE:
+        stateName = "webinarPromote";
+        break;
+      case MEETING_STATUS_WEBINAR_DEPROMOTE:
+        stateName = "webinarDePromote";
+        break;
+      case MEETING_STATUS_UNKNOWN:
+      default:
+        stateName = "unknown";
+    }
+
+    WritableMap params = Arguments.createMap();
+    params.putInt("state", meetingStatus.ordinal());
+    params.putString("stateName", stateName);
+    params.putInt("errorCode", errorCode);
+    params.putInt("internalErrorCode", internalErrorCode);
+    sendEvent(reactContext, "onMeetingStateChange", params);
+
+    // If meeting failed, also send error event
+    if (meetingStatus == MeetingStatus.MEETING_STATUS_FAILED) {
+      WritableMap errorParams = Arguments.createMap();
+      errorParams.putInt("errorCode", errorCode);
+      errorParams.putString("message", "Meeting failed with error code: " + errorCode);
+      sendEvent(reactContext, "onMeetingError", errorParams);
+    }
+  }
