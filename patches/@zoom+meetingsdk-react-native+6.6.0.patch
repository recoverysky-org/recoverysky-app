+RCT_REMAP_METHOD(leaveMeeting,
+        leaveMeetingWithEnd:(BOOL)endMeeting
+        withResolver:(RCTPromiseResolveBlock)resolve
+        withRejecter:(RCTPromiseRejectBlock)reject)
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        MobileRTCMeetingService *meetService = [[MobileRTC sharedRTC] getMeetingService];
+        if (meetService) {
+            if (endMeeting) {
+                [meetService leaveMeetingWithCmd:LeaveMeetingCmd_End];
+            } else {
+                [meetService leaveMeetingWithCmd:LeaveMeetingCmd_Leave];
+            }
+            NSLog(@"[RNZoomSDK] leaveMeeting called, endMeeting: %@", endMeeting ? @"YES" : @"NO");
+            resolve(@(YES));
+        } else {
+            reject(@"no_meeting", @"No active meeting", nil);
+        }
+    });
+}
